{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/api/v1/:p*",
      "destination": "/api/gateway?p=:p*"
    },
    {
      "source": "/order",
      "destination": "/order.html"
    },
    {
      "source": "/orders",
      "destination": "/orders.html"
    },
    {
      "source": "/wallet",
      "destination": "/wallet.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/gift",
      "destination": "/gift.html"
    },
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "destination": "/api/applepay-domain"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    },
    "api/pass.js": {
      "maxDuration": 10,
      "includeFiles": "public/pass/**"
    }
  }
}